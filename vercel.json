{
  "rewrites": [
    { "source": "/toposadmin", "destination": "/customarticle.html" },
    { "source": "/customarticle", "destination": "/customarticle.html" }
  ],
  "headers": [
    { "source": "/toposadmin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/customarticle", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
